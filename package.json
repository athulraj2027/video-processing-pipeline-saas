{
  "name": "saas-vod-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "services/*",
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "gateway:dev": "npm run dev -w services/api-gateway",
    "gateway:build": "npm run build -w services/api-gateway",
    "identity:dev": "npm run dev -w services/identity-service",
    "identity:build": "npm run build -w services/identity-service",
    "identity:start": "npm run start -w services/identity-service",
    "tenant:dev": "npm run dev -w services/tenant-service",
    "tenant:build": "npm run build -w services/tenant-service",
    "tenant:start": "npm run start -w services/tenant-service",
    "catalog:dev": "npm run dev -w services/catalog-service",
    "catalog:build": "npm run build -w services/catalog-service",
    "catalog:start": "npm run start -w services/catalog-service",
    "upload:dev": "npm run dev -w services/upload-service",
    "upload:build": "npm run build -w services/upload-service",
    "upload:start": "npm run start -w services/upload-service",
    "libs:build": "npm run build -w libs/auth-middleware",
    "frontend:dev": "npm run dev -w services/frontend",
    "frontend:build": "npm run build -w services/frontend",
    "frontend:start": "npm run start -w services/frontend",
    "notification:dev": "npm run dev -w services/notification-service",
    "notification:build": "npm run build -w services/notification-service",
    "notification:start": "npm run start -w services/notification-service",
    "notification:prisma:generate": "npm run prisma:generate -w services/notification-service",
    "notification:prisma:migrate": "npm run prisma:migrate -w services/notification-service"
  }
}
