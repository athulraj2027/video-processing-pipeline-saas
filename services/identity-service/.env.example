# Identity Service Configuration
PORT=4001
HOST=0.0.0.0
NODE_ENV=development

# JWT Secrets & Expiration
JWT_SECRET=your_super_secret_jwt_signing_key_at_least_8_chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_signing_key
REFRESH_TOKEN_EXPIRES_IN=7d

# Database Configuration (falls back to local JSON database if empty)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/identity?schema=public
