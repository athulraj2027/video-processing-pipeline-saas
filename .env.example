# Gateway Service Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
JWT_SECRET=your_super_secret_jwt_signing_key_at_least_8_chars

# Downstream Microservices Targets (Local defaults)
IDENTITY_SERVICE_URL=http://localhost:4001
CATALOG_SERVICE_URL=http://localhost:4002
UPLOAD_SERVICE_URL=http://localhost:4003
PLAYBACK_SERVICE_URL=http://localhost:4004

# Tenant Hostname Mapping (comma-separated "host=tenantId")
TENANT_MAPPING=localhost:3000=tenant_default,studio.localhost:3000=tenant_studio
